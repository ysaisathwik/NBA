# Copy to .env to enable real LLM reasoning. All optional — the platform runs offline without them.

# Anthropic / Claude (recommended). Without a key the platform uses deterministic fallbacks.
ANTHROPIC_API_KEY=

# Model selection (defaults shown).
NBA_LLM_MODEL=claude-opus-4-8
NBA_LLM_FAST_MODEL=claude-haiku-4-5

# Which business domain pack to load (energy ships in-box).
NBA_DOMAIN=energy

# Where the long-term SQLite store lives (":memory:" for ephemeral demos).
NBA_DB_PATH=nba_platform.db

# Set to 1 to force deterministic mode even if an API key is present (useful for reproducible demos).
NBA_FORCE_OFFLINE=0
