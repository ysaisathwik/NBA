# Copy to .env to configure the platform. All values are optional — the platform runs fully
# offline (deterministic LLM fallback + SQLite store) with no configuration at all.

# ----- LLM (Claude) -----------------------------------------------------------
# Without a key the platform uses deterministic rule-based fallbacks.
ANTHROPIC_API_KEY=
NBA_LLM_MODEL=claude-opus-4-8
NBA_LLM_FAST_MODEL=claude-haiku-4-5
NBA_FORCE_OFFLINE=0

# ----- Domain + local store ---------------------------------------------------
NBA_DOMAIN=energy
NBA_DB_PATH=nba_platform.db

# ----- Auth -------------------------------------------------------------------
# Secret used to sign JWTs. CHANGE THIS IN PRODUCTION.
JWT_SECRET=nba-platform-dev-secret-change-in-prod

# ----- Supabase (optional) ----------------------------------------------------
# When BOTH are set and the `supabase` package is installed, the long-term store
# uses Supabase/Postgres (apply supabase_schema.sql first). Otherwise SQLite is used.
SUPABASE_URL=
SUPABASE_KEY=
