# Copy to .env and fill in your values

# LLM (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# LLM models
NBA_LLM_MODEL=claude-opus-4-8
NBA_LLM_FAST_MODEL=claude-haiku-4-5

# JWT secret — change this in production (min 32 chars)
JWT_SECRET=change-this-in-production-min-32-chars

# Database
# Leave blank to use SQLite (default). Set both for Supabase.
SUPABASE_URL=
SUPABASE_KEY=

# Set to 1 to force offline demo mode (no API key needed)
NBA_FORCE_OFFLINE=0

# Domain
NBA_DOMAIN=energy

# SQLite path (used when Supabase is not configured)
NBA_DB_PATH=nba_platform.db

# ── Email delivery ────────────────────────────────────────────────────────
# Option A: SendGrid (recommended for production)
SENDGRID_API_KEY=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

# Option B: SMTP (e.g. Gmail, Mailgun SMTP, AWS SES SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender address shown in the From: field
EMAIL_FROM=noreply@nexus-platform.com

# App base URL — used to build clickable deep-links in emails.
# Change this to your deployed URL in production.
APP_BASE_URL=http://localhost:8000
