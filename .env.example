# Copy to .env and fill in your values

# LLM (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# LLM models
NBA_LLM_MODEL=claude-opus-4-8
NBA_LLM_FAST_MODEL=claude-haiku-4-5

# JWT secret — change this in production (min 32 chars)
JWT_SECRET=change-this-in-production-min-32-chars

# Database
# Leave blank to use SQLite (default). Set both for Supabase.
SUPABASE_URL=
SUPABASE_KEY=

# Set to 1 to force offline demo mode (no API key needed)
NBA_FORCE_OFFLINE=0

# Domain
NBA_DOMAIN=energy

# SQLite path (used when Supabase is not configured)
NBA_DB_PATH=nba_platform.db
